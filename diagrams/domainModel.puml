@startuml Domain Model 
skinparam DefaultFontName Arial
skinparam DefaultFontSize 16
skinparam DefaultFontStyle bold
skinparam ArrowThickness 2.0
skinparam ArrowColor #black

class "User" as User {
    roles: UserRoles
}

'id could be GUID so TBD??'
'TBC if lat/long are double'
class "Customer" as Customer {
    id: int
    name: String
    latAddress: double
    longAddress: double
}

'TBC if lat/long are double'
'menu: ?? could be another class that connects to Menu Item'
class "Restaurant" as Restaurant {
    name: String
    status: RestaurantStatus
    latPosition: double
    longPosition: double
}

class "Restaurant Personnel" as RestPers {
    isOwner: bool
}

'id could be GUID so TBD??'
'TBC if lat/long are double'
class "Courier" as Courier {
    id: int
    latPosition: double
    longPosition: double
    status: CourierState
}

class "Platform Operator" as PlatOp {

}

class "Order" as Order {
    status: OrderStatus
}

'One Menu item and qty'
class "Order Line" as OrderLine {
    quantity: int
}

class "Menu" as Menu {

}

'id could be a string/int mix like GUID so TBD??'
class "Menu Item" as MenuItem {
    id: int
    name: String
    price: double
    status: MenuItemStatus
}


class "Preparation Queue" as PQ {

}

'Talks about "Records two handoffs that close a delivery...", not sure if they're talking about time or what
class "Order Assignment" as Assignment {
    pickupTime: Time
    deliveryTime: Time
}

class "Dispatch Queue" as DQ {

}

class "Order History" as OrderHistory {
    /charges: double
    date: Date
    time: Time
}



'---------- List of associations/relationships -----------'
User <|-- Courier
User <|-- Customer
User <|-- RestPers
User <|-- PlatOp

'Restaurant, MenuItem related ===================='
Restaurant o-- RestPers
RestPers "1 owner" -- "* staff" RestPers: "manages"
Restaurant "1" -- "1" Menu : "publishes"
Menu *-- MenuItem 
(MenuItem, Order) .. OrderLine
PQ *-- Order
Restaurant "1" -- "1" PQ: "handles >"
'Not sure about the one below either, it's subtly implied. [placeholder] = find verbPhrase
Restaurant "1" -- "1" DQ: "[placeholder]"

'Order related ===================='
'Not sure about the one below'
RestPers "*" -- "*" Order: "manages >"
'Not sure if we need two associations for submit and delete or if there is a word for both'
Customer "1" -- "*" Order: "requests >" 
DQ "1" -- "*" Order: "holds >"


'Courier-Assignment related ====================''
'Not sure about the two below, do we need an Assignment class? or just do Courier to Order'
Courier "1" -- "*" Assignment: "can-take-on >"
Courier "1" -- "1" Assignment: "is-assigned <" 
Assignment "1" -- "1" Order

'Order-History related ====================''
OrderHistory "1" -- "1" Order


'-----List of possible enum classes: capitalize them??-------'
enum "UserRoles" as UserRoles {
    customer
    restaurant
    courier
    operator
}

enum "OrderStatus" as OrderStatus {
    placed
    accepted
    preparing
    ready
    picked_up
    delivered
}

'Or we can create a boolean attribute in Menu Item, or derived based on qty'
enum "MenuItemStatus" as MenuItemStatus {
    available
    sold_out
}

enum "RestaurantStatus" as RestaurantStatus {
    open
    paused
    closed
}

enum "CourierState" as CourierState {
    offline
    idle
    assigned
    carrying
}

@enduml